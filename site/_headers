# Cloudflare Pages headers for the gliim marketing site.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=()

/*.html
  Cache-Control: public, max-age=3600

# Asset filenames here are NOT content-hashed — hero.jpg keeps its name when its
# contents change. A long immutable cache therefore pins stale images at both the
# Cloudflare edge and in browsers, and `immutable` specifically tells browsers not
# to revalidate even on a force-reload. Short max-age + revalidation instead: the
# ETag makes the recheck a 304 with no body, so it costs almost nothing.
/assets/*
  Cache-Control: public, max-age=300, must-revalidate
